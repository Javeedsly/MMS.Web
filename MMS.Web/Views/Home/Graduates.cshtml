@using MMS.Core.Entities
@model IEnumerable<AppUser>
@{
    ViewData["Title"] = "Məzunlar";
}

<div class="page-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading text-center mb-5">
                    <h4>Bizim <em>Məzunlar</em></h4>
                    <img src="~/assets/images/heading-line-dec.png" alt="">
                    <p>Məzunlarımızla fəxr edirik</p>
                </div>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var user in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="graduate-item">
                            <div class="graduate-img-wrapper">
                                @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                                {
                                    <img src="~/uploads/@user.ProfileImageUrl" alt="@user.FirstName">
                                }
                                else
                                {
                                    <img src="https://ui-avatars.com/api/?name=@user.FirstName+@user.LastName&background=random" alt="Default Profile">
                                }
                            </div>
                            <div class="graduate-info">
                                <h5>@user.FirstName @user.LastName</h5>
                                <span class="profession">@(user.Profession ?? "Məzun")</span>
                            </div>

                            <div class="graduate-details">
                                <p>
                                    <strong>Təhsil:</strong>
                                    @if (!string.IsNullOrEmpty(user.University))
                                    {
                                        <span>@user.University</span>
                                    }
                                    else
                                    {
                                        <span>Qeyd olunmayıb</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(user.Degree))
                                {
                                    <p><strong>İxtisas:</strong> @user.Degree</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="alert alert-info">
                        Hələlik sistemdə qeydiyyatdan keçmiş məzun yoxdur.
                    </div>
                </div>
            }
        </div>
    </div>
</div>